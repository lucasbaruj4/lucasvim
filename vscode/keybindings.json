// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+f4",
        "command": "-workbench.action.closeActiveEditor"
    },
    {
        "key": "ctrl+shift+e",
        "command": "-workbench.view.explorer",
        "when": "viewContainer.workbench.view.explorer.enabled"
    },
    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+numpad_multiply",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+`",
        "command": "-workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+shift+numpad_multiply",
        "command": "workbench.action.terminal.new",
        "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
    },
    {
        "key": "ctrl+shift+`",
        "command": "-workbench.action.terminal.new",
        "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
    },
    {
        "key": "ctrl+tab",
        "command": "-workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
        "when": "!activeEditorGroupEmpty"
    },
    {
        "key": "shift+tab",
        "command": "workbench.action.quickOpenNavigateNextInEditorPicker",
        "when": "inEditorsPicker && inQuickOpen"
    },
    {
        "key": "ctrl+tab",
        "command": "-workbench.action.quickOpenNavigateNextInEditorPicker",
        "when": "inEditorsPicker && inQuickOpen"
    },
    {
        "key": "shift+n",
        "command": "workbench.action.files.newUntitledFile"
    },
    {
        "key": "ctrl+n",
        "command": "-workbench.action.files.newUntitledFile"
    },
    {
        "key": "ctrl+shift+alt+`",
        "command": "-workbench.action.terminal.newInNewWindow",
        "when": "terminalHasBeenCreated || terminalProcessSupported"
    },
    {
        "key": "shift+backspace",
        "command": "editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+k",
        "command": "-editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "shift+f",
        "command": "workbench.action.quickOpen",
        "when": "!terminalFocus && !inputFocus || editorTextFocus"
    },
    {
        "key": "ctrl+s",
        "command": "workbench.action.files.save"
    },
    {
        "key": "shift+space",
        "command": "editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
    },
    {
        "key": "ctrl+space",
        "command": "-editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
    },
    // TAB moves down in suggestion list
    {
        "key": "tab",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetVisible"
    },
    // SHIFT+TAB moves up in suggestion list
    {
        "key": "shift+tab",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetVisible"
    },
    // ENTER accepts suggestion (normal)
    {
        "key": "enter",
        "command": "acceptSelectedSuggestion",
        "when": "suggestWidgetVisible"
    },
    // PREVENT tab from accepting suggestions
    {
        "key": "tab",
        "command": "-acceptSelectedSuggestion",
        "when": "suggestWidgetVisible"
    },
    {
        "key": "shift+f2",
        "command": "editor.action.changeAll",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+f2",
        "command": "-editor.action.changeAll",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+pageup",
        "command": "-workbench.action.previousEditor"
    },
    {
        "key": "ctrl+pagedown",
        "command": "-workbench.action.nextEditor"
    },
    {
        "key": "ctrl+shift+tab",
        "command": "-workbench.action.quickOpenLeastRecentlyUsedEditorInGroup",
        "when": "!activeEditorGroupEmpty"
    },
    {
        "key": "shift+b",
        "command": "markdown.extension.editing.toggleBold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+b",
        "command": "-markdown.extension.editing.toggleBold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "shift+i",
        "command": "markdown.extension.editing.toggleItalic",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+i",
        "command": "-markdown.extension.editing.toggleItalic",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.togglePanel"
    },
    {
        "key": "ctrl+j",
        "command": "-workbench.action.togglePanel"
    },
    {
        "key": "shift+left",
        "command": "workbench.action.closePanel"
    },
    {
        "key": "ctrl+d",
        "command": "lucasT3.closeFile"
    },
    {
        "key": "ctrl+e",
        "command": "lucasT3.explorer"
    },
    {
        "key": "ctrl+w",
        "command": "lucasT3.nextFile"
    },
    {
        "key": "ctrl+q",
        "command": "lucasT3.previousFile"
    },
    {
        "key": "shift+c",
        "command": "lucasT3.toggle",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+alt+f12",
        "command": "lucasT3.toggle"
    },
    {
        "key": "ctrl+t",
        "command": "lucasT3.terminal"
    },
    {
        "key": "ctrl+alt+f11",
        "command": "lucasT3.explorer"
    },
    {
        "key": "ctrl+alt+f10",
        "command": "lucasT3.closeFile"
    },
    {
        "key": "ctrl+alt+f9",
        "command": "lucasT3.terminal"
    },
    {
        "key": "ctrl+alt+f7",
        "command": "lucasT3.previousFile"
    },
    {
        "key": "ctrl+alt+f8",
        "command": "lucasT3.nextFile"
    },
    {
        "key": "ctrl+alt+f6",
        "command": "workbench.action.files.save"
    },
    {
        "key": "ctrl+r",
        "command": "lucasCodex.projects",
        "when": "!inQuickOpen"
    },
    {
        "key": "ctrl+alt+f5",
        "command": "lucasCodex.projects",
        "when": "!inQuickOpen"
    },
    {
        "key": "ctrl+alt+f5",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    }
]
