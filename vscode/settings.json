{
    "chat.disableAIFeatures": true,
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "workbench.startupEditor": "none",
    "workbench.browser.newTabPlacement": "activeGroup",
    "workbench.statusBar.visible": false,
    "editor.wordWrap": "on",
    "git.openRepositoryInParentFolders": "always",
    "explorer.confirmDragAndDrop": false,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "git.confirmSync": false,
    "git.autofetch": true,
    "files.autoSave": "onFocusChange",
    "git.enableSmartCommit": true,
    "editor.fontFamily": "CaskaydiaMono Nerd Font Mono",
    "workbench.colorTheme": "One Dark Pro Night Flat",
    "security.allowedUNCHosts": [
        "wsl.localhost",
        "wsl$"
    ],
    "markdown-preview-enhanced.enablePreviewZenMode": false,
    "terminal.integrated.initialHint": false,
    "workbench.activityBar.location": "hidden",
    "workbench.sideBar.location": "left",
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.enablePreview": false,
    "workbench.editor.closeEmptyGroups": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.layoutControl.enabled": false,
    "window.commandCenter": false,
    "window.menuBarVisibility": "toggle",
    "breadcrumbs.enabled": false,
    "explorer.openEditors.visible": 0,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "vscode-neovim.useWSL": true,
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/local/bin/nvim",
    "extensions.ignoreRecommendations": true,
    "workbench.iconTheme": "vscode-icons",
    "terminal.integrated.commandsToSkipShell": [
        "lucasT3.toggle",
        "lucasT3.files",
        "lucasT3.nextFile",
        "lucasT3.previousFile",
        "lucasT3.explorer",
        "lucasT3.terminal",
        "lucasT3.closeFile",
        "workbench.action.openRecent",
        "lucasT3.projects"
    ],
    "workbench.browser.dataStorage": "global",
    "workbench.externalBrowser": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
