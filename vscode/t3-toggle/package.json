{
  "name": "t3-toggle",
  "displayName": "Lucas T3 Toggle",
  "description": "Browse Codex projects in WSL and switch between T3 and file editors.",
  "version": "1.1.7",
  "publisher": "lucas",
  "engines": { "vscode": "^1.100.0" },
  "extensionKind": ["ui"],
  "enabledApiProposals": ["browser", "externalUriOpener"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "lucasT3.toggle", "title": "T3: Toggle T3 and Files" },
      { "command": "lucasT3.files", "title": "T3: Return to Files" },
      { "command": "lucasT3.nextFile", "title": "T3: Next File Tab" },
      { "command": "lucasT3.previousFile", "title": "T3: Previous File Tab" },
      { "command": "lucasT3.explorer", "title": "T3: Toggle Explorer" },
      { "command": "lucasT3.terminal", "title": "T3: Open Terminal" },
      { "command": "lucasT3.closeFile", "title": "T3: Close File or Return to Files" },
      { "command": "lucasCodex.projects", "title": "Codex Projects" }
    ]
  }
}
